[sub_resource type="GDScript" id="GDScript_j2dk4"]
script/source = "extends CanvasLayer

@export var vida = 0

@onready var hurtbox: Hurtbox = $\"../Pivot/Mage/Hurtbox\"
@onready var heart: Sprite2D = $Heart
@onready var heart_2: Sprite2D = $Heart2
@onready var heart_3: Sprite2D = $Heart3
@onready var progress_bar: ProgressBar = $ProgressBar
@onready var timer: Timer = $Timer

func incrementa_una_vida():
	vida += 1
	if (vida == 2):
		heart_2.visible = true
	elif (vida == 3):
		heart_3.visible = true
"

