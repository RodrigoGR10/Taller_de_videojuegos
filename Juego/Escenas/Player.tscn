[sub_resource type="GDScript" id="GDScript_j2dk4"]
script/source = "extends CanvasLayer

@export var vida = 0

@onready var vida_jugador: Label = $Vida_Jugador
@onready var progress_bar: ProgressBar = $GameManager/ProgressBar
@onready var hurtbox: Hurtbox = $\"../Pivot/Mage/Hurtbox\"
@onready var frasco_morado: Sprite2D = $Frasco_morado
@onready var frasco_gris: Sprite2D = $Frasco_gris
@onready var frasco_amarillo: Sprite2D = $Frasco_amarillo
@onready var frasco_celeste: Sprite2D = $Frasco_celeste
@onready var frasco_cafe: Sprite2D = $Frasco_cafe
@onready var frasco_amarillo_tuto: Sprite2D = $Frasco_amarillo_tuto

func incrementa_una_vida():
	vida += 1
	vida_jugador.text = str(vida)
"

